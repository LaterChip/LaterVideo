<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="LaterVideo.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:LaterVideo.Models"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
          AllowDrop="True"
          DragEnter="RootGrid_DragEnter"
          DragOver="RootGrid_DragOver"
          DragLeave="RootGrid_DragLeave"
          Drop="RootGrid_Drop">

        <Grid.Resources>
            <Style x:Key="FileRowContainerStyle" TargetType="ListViewItem">
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="MinHeight" Value="38" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>

            <!-- 网格卡片容器：拉伸填满 tile，配合 ItemsWrapGrid 的 ItemWidth/ItemHeight 实现尺寸档位 -->
            <Style x:Key="FileTileContainerStyle" TargetType="GridViewItem">
                <Setter Property="Padding" Value="6" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
            </Style>

            <!-- 侧边栏功能入口按钮：展开时左对齐铺满，折叠时图标居中 -->
            <Style x:Key="SideBarButtonStyle" TargetType="Button">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Background" Value="Transparent" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ 自定义标题栏 ============ -->
        <!-- 标题栏已扩展进工作区（ExtendsContentIntoTitleBar），系统不再绘制标题栏下沿的分隔线 -->
        <Grid x:Name="AppTitleBar"
              Grid.Row="0"
              Height="44"
              Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <FontIcon Glyph="&#xE786;"
                      Margin="16,0,0,0"
                      FontSize="16"
                      VerticalAlignment="Center"
                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />

            <TextBlock Grid.Column="1"
                       Margin="10,0,0,0"
                       VerticalAlignment="Center"
                       Text="LaterVideo"
                       Style="{ThemeResource CaptionTextBlockStyle}" />

            <!-- 右侧占位：为系统的最小化 / 最大化 / 关闭按钮（含贴靠布局热区）留出空间 -->
            <Border x:Name="TitleBarRightPadding"
                    Grid.Column="2"
                    Width="140"
                    Background="Transparent" />
        </Grid>

        <!-- ============ 侧边栏 + 主内容区 ============ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SideBarColumn" Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== 左侧边栏：收纳原顶部工具栏的全部功能入口，支持折叠为纯图标 ===== -->
            <Border x:Name="SideBar"
                    Grid.Column="0"
                    BorderThickness="0,0,1,0"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0"
                                  Padding="8,8,8,0"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="4">

                            <!-- 分组：导入 -->
                            <TextBlock Text="导入"
                                       Margin="10,4,0,2"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Visibility="{x:Bind SidebarTextVisibility, Mode=OneWay}" />

                            <Button x:Name="AddButton"
                                    Click="AddButton_Click"
                                    Style="{StaticResource SideBarButtonStyle}"
                                    HorizontalContentAlignment="{x:Bind SidebarItemContentAlignment, Mode=OneWay}"
                                    ToolTipService.ToolTip="添加文件（也可把文件 / 文件夹直接拖入窗口）">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE710;" FontSize="15" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="添加文件"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{x:Bind SidebarTextVisibility, Mode=OneWay}" />
                                </Grid>
                            </Button>

                            <Button x:Name="AddFolderButton"
                                    Click="AddFolderButton_Click"
                                    Style="{StaticResource SideBarButtonStyle}"
                                    HorizontalContentAlignment="{x:Bind SidebarItemContentAlignment, Mode=OneWay}"
                                    ToolTipService.ToolTip="添加文件夹（递归导入其中的所有文件）">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE8B7;" FontSize="15" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="添加文件夹"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{x:Bind SidebarTextVisibility, Mode=OneWay}" />
                                </Grid>
                            </Button>

                            <AutoSuggestBox x:Name="SearchBox"
                                            HorizontalAlignment="Stretch"
                                            QueryIcon="Find"
                                            PlaceholderText="按文件名或路径搜索"
                                            TextChanged="SearchBox_TextChanged"
                                            Visibility="{x:Bind SidebarTextVisibility, Mode=OneWay}" />

                            <Button x:Name="SearchIconButton"
                                    Click="SearchIconButton_Click"
                                    Style="{StaticResource SideBarButtonStyle}"
                                    HorizontalContentAlignment="Center"
                                    ToolTipService.ToolTip="搜索"
                                    Visibility="{x:Bind SidebarIconVisibility, Mode=OneWay}">
                                <FontIcon Glyph="&#xE721;" FontSize="15" HorizontalAlignment="Center" />
                            </Button>

                            <Border Height="1"
                                    Margin="10,6,10,6"
                                    Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                                    Visibility="{x:Bind SidebarTextVisibility, Mode=OneWay}" />

                            <!-- 分组：操作 -->
                            <TextBlock Text="操作"
                                       Margin="10,0,0,2"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Visibility="{x:Bind SidebarTextVisibility, Mode=OneWay}" />

                            <Button x:Name="RemoveButton"
                                    Click="RemoveButton_Click"
                                    Style="{StaticResource SideBarButtonStyle}"
                                    HorizontalContentAlignment="{x:Bind SidebarItemContentAlignment, Mode=OneWay}"
                                    ToolTipService.ToolTip="移除选中（仅从列表移除，不动磁盘文件）">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE738;" FontSize="15" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="移除选中"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{x:Bind SidebarTextVisibility, Mode=OneWay}" />
                                </Grid>
                            </Button>

                            <Button x:Name="ClearButton"
                                    Click="ClearButton_Click"
                                    Style="{StaticResource SideBarButtonStyle}"
                                    HorizontalContentAlignment="{x:Bind SidebarItemContentAlignment, Mode=OneWay}"
                                    ToolTipService.ToolTip="清空列表（不动磁盘文件）">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE894;" FontSize="15" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="清空列表"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{x:Bind SidebarTextVisibility, Mode=OneWay}" />
                                </Grid>
                            </Button>

                            <Button x:Name="BatchRenameButton"
                                    Click="BatchRenameButton_Click"
                                    Style="{StaticResource SideBarButtonStyle}"
                                    HorizontalContentAlignment="{x:Bind SidebarItemContentAlignment, Mode=OneWay}"
                                    ToolTipService.ToolTip="批量重命名（统一前缀 + 递增序号，仅改名不移动）">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE8AC;" FontSize="15" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="批量重命名"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{x:Bind SidebarTextVisibility, Mode=OneWay}" />
                                </Grid>
                            </Button>

                            <Button x:Name="ExportCsvButton"
                                    Click="ExportCsvButton_Click"
                                    Style="{StaticResource SideBarButtonStyle}"
                                    HorizontalContentAlignment="{x:Bind SidebarItemContentAlignment, Mode=OneWay}"
                                    ToolTipService.ToolTip="导出当前列表为 CSV 文件">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE9F9;" FontSize="15" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="导出 CSV"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{x:Bind SidebarTextVisibility, Mode=OneWay}" />
                                </Grid>
                            </Button>

                            <Button x:Name="ExportTxtButton"
                                    Click="ExportTxtButton_Click"
                                    Style="{StaticResource SideBarButtonStyle}"
                                    HorizontalContentAlignment="{x:Bind SidebarItemContentAlignment, Mode=OneWay}"
                                    ToolTipService.ToolTip="导出当前列表为 TXT 文件">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE8A5;" FontSize="15" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="导出 TXT"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{x:Bind SidebarTextVisibility, Mode=OneWay}" />
                                </Grid>
                            </Button>

                            <Border Height="1"
                                    Margin="10,6,10,6"
                                    Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                                    Visibility="{x:Bind SidebarTextVisibility, Mode=OneWay}" />

                            <!-- 分组：视图 -->
                            <TextBlock Text="视图"
                                       Margin="10,0,0,2"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Visibility="{x:Bind SidebarTextVisibility, Mode=OneWay}" />

                            <Button x:Name="ViewToggleButton"
                                    Click="ViewToggleButton_Click"
                                    Style="{StaticResource SideBarButtonStyle}"
                                    HorizontalContentAlignment="{x:Bind SidebarItemContentAlignment, Mode=OneWay}"
                                    ToolTipService.ToolTip="在列表视图与缩略图网格视图之间切换">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon x:Name="ViewToggleIcon" Glyph="&#xE727;" FontSize="15" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="ViewToggleText"
                                               Grid.Column="1"
                                               Text="切换为网格视图"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{x:Bind SidebarTextVisibility, Mode=OneWay}" />
                                </Grid>
                            </Button>

                            <ComboBox x:Name="CategoryFilter"
                                      HorizontalAlignment="Stretch"
                                      SelectionChanged="CategoryFilter_SelectionChanged"
                                      Visibility="{x:Bind SidebarTextVisibility, Mode=OneWay}" />

                            <Button x:Name="CategoryIconButton"
                                    Click="CategoryIconButton_Click"
                                    Style="{StaticResource SideBarButtonStyle}"
                                    HorizontalContentAlignment="Center"
                                    ToolTipService.ToolTip="分类筛选"
                                    Visibility="{x:Bind SidebarIconVisibility, Mode=OneWay}">
                                <FontIcon Glyph="&#xE8B7;" FontSize="15" HorizontalAlignment="Center" />
                            </Button>

                            <ComboBox x:Name="SortBox"
                                      HorizontalAlignment="Stretch"
                                      SelectionChanged="SortBox_SelectionChanged"
                                      Visibility="{x:Bind SidebarTextVisibility, Mode=OneWay}" />

                            <Button x:Name="SortIconButton"
                                    Click="SortIconButton_Click"
                                    Style="{StaticResource SideBarButtonStyle}"
                                    HorizontalContentAlignment="Center"
                                    ToolTipService.ToolTip="排序"
                                    Visibility="{x:Bind SidebarIconVisibility, Mode=OneWay}">
                                <FontIcon Glyph="&#xE8CB;" FontSize="15" HorizontalAlignment="Center" />
                            </Button>

                            <Border Height="1"
                                    Margin="10,6,10,6"
                                    Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                                    Visibility="{x:Bind SidebarTextVisibility, Mode=OneWay}" />

                            <!-- 分组：其他 -->
                            <TextBlock Text="其他"
                                       Margin="10,0,0,2"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Visibility="{x:Bind SidebarTextVisibility, Mode=OneWay}" />

                            <Button x:Name="SettingsButton"
                                    Click="SettingsButton_Click"
                                    Style="{StaticResource SideBarButtonStyle}"
                                    HorizontalContentAlignment="{x:Bind SidebarItemContentAlignment, Mode=OneWay}"
                                    ToolTipService.ToolTip="设置（关于 / 外观 / 数据）">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE713;" FontSize="15" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="设置"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{x:Bind SidebarTextVisibility, Mode=OneWay}" />
                                </Grid>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 底部：自动保存提示 + 折叠 / 展开 -->
                    <StackPanel Grid.Row="1" Padding="8,6,8,8" Spacing="6">
                        <Border Height="1"
                                Margin="2,0,2,2"
                                Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <TextBlock x:Name="AutoSaveHint"
                                   Margin="2,0,2,0"
                                   TextWrapping="Wrap"
                                   Text="列表与视图设置已自动保存，下次启动自动恢复"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <Button x:Name="SideBarToggleButton"
                                Click="SideBarToggleButton_Click"
                                Style="{StaticResource SideBarButtonStyle}"
                                HorizontalContentAlignment="{x:Bind SidebarItemContentAlignment, Mode=OneWay}"
                                ToolTipService.ToolTip="{x:Bind SidebarToggleTooltip, Mode=OneWay}">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="{x:Bind SidebarToggleGlyph, Mode=OneWay}" FontSize="15" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="折叠侧边栏"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="{x:Bind SidebarTextVisibility, Mode=OneWay}" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== 主内容区：文件列表 / 网格 + 预览面板 ===== -->
            <Grid Grid.Column="1" Margin="12,12,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="200" />
                    <ColumnDefinition x:Name="PreviewSpacerColumn" Width="12" />
                    <ColumnDefinition x:Name="PreviewColumn" Width="1.2*" />
                </Grid.ColumnDefinitions>

            <!-- 文件列表 -->
            <Border Grid.Column="0"
                    CornerRadius="8"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 表头（仅列表视图显示） -->
                    <Border x:Name="ListHeader"
                            Grid.Row="0"
                            Padding="8,8"
                            BorderThickness="0,0,0,1"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="104" />
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="140" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1"
                                       Text="文件名"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="2"
                                       Text="类型"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="3"
                                       Text="大小"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="4"
                                       Text="修改时间"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <!-- 列表视图 -->
                        <ListView x:Name="FileListView"
                                  SelectionMode="Extended"
                                  ItemContainerStyle="{StaticResource FileRowContainerStyle}"
                                  SelectionChanged="FileListView_SelectionChanged"
                                  DoubleTapped="FileListView_DoubleTapped">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:FileItem">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="104" />
                                            <ColumnDefinition Width="92" />
                                            <ColumnDefinition Width="140" />
                                        </Grid.ColumnDefinitions>

                                        <FontIcon Glyph="{x:Bind Glyph}"
                                                  FontSize="15"
                                                  VerticalAlignment="Center"
                                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />

                                        <TextBlock Grid.Column="1"
                                                   Text="{x:Bind Name}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTipService.ToolTip="{x:Bind FullPath}" />

                                        <TextBlock Grid.Column="2"
                                                   Text="{x:Bind CategoryName}"
                                                   Style="{StaticResource CellSecondaryTextStyle}" />

                                        <TextBlock Grid.Column="3"
                                                   Text="{x:Bind SizeText}"
                                                   Style="{StaticResource CellSecondaryTextStyle}" />

                                        <TextBlock Grid.Column="4"
                                                   Text="{x:Bind ModifiedText}"
                                                   Style="{StaticResource CellSecondaryTextStyle}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- 缩略图网格视图：图片显示缩略图，其他类型显示分类图标 -->
                        <GridView x:Name="FileGridView"
                                  Visibility="Collapsed"
                                  SelectionMode="Extended"
                                  ItemContainerStyle="{StaticResource FileTileContainerStyle}"
                                  Loaded="FileGridView_Loaded"
                                  SelectionChanged="FileGridView_SelectionChanged"
                                  ContainerContentChanging="FileGridView_ContainerContentChanging"
                                  DoubleTapped="FileGridView_DoubleTapped">
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid Orientation="Horizontal"
                                                   ItemWidth="152"
                                                   ItemHeight="180" />
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="models:FileItem">
                                    <Grid Padding="4"
                                          RowSpacing="6"
                                          ToolTipService.ToolTip="{x:Bind FullPath}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Border Grid.Row="0"
                                                CornerRadius="6"
                                                BorderThickness="1"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                Background="{ThemeResource LayerFillColorDefaultBrush}">
                                            <Grid>
                                                <FontIcon Glyph="{x:Bind Glyph}"
                                                          FontSize="34"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Visibility="{x:Bind IconVisibility, Mode=OneWay}"
                                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                <Image Source="{x:Bind Thumbnail, Mode=OneWay}"
                                                       Stretch="Uniform"
                                                       Visibility="{x:Bind ImageVisibility, Mode=OneWay}" />
                                            </Grid>
                                        </Border>

                                        <TextBlock Grid.Row="1"
                                                   Text="{x:Bind Name}"
                                                   FontSize="12"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis" />

                                        <TextBlock Grid.Row="2"
                                                   Text="{x:Bind SizeText}"
                                                   FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>

                        <!-- 空状态 -->
                        <StackPanel x:Name="EmptyHint"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Spacing="10"
                                    IsHitTestVisible="False">
                            <FontIcon Glyph="&#xE896;"
                                      FontSize="42"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                      HorizontalAlignment="Center" />
                            <TextBlock Text="把文件或文件夹拖到这里"
                                       HorizontalAlignment="Center"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="支持图片 / 音乐音频 / 视频 / 文本 / 配置文件 / 文档等，也可点击左侧边栏「添加文件」"
                                       HorizontalAlignment="Center"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       MaxWidth="380"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- 预览面板（窗口较窄时自动收起，保证主内容区不错位） -->
            <Border x:Name="PreviewPanel"
                    Grid.Column="2"
                    CornerRadius="8"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid Padding="16" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="预览" Style="{ThemeResource SubtitleTextBlockStyle}" />

                    <Grid Grid.Row="1" MinHeight="180">
                        <Image x:Name="PreviewImage"
                               Stretch="Uniform"
                               Visibility="Collapsed" />

                        <TextBox x:Name="PreviewText"
                                 Visibility="Collapsed"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 VerticalAlignment="Stretch"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" />

                        <MediaPlayerElement x:Name="MediaPlayer"
                                            Visibility="Collapsed"
                                            AreTransportControlsEnabled="True"
                                            Stretch="Uniform" />

                        <StackPanel x:Name="PreviewPlaceholder"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Spacing="10">
                            <FontIcon Glyph="&#xE7C3;"
                                      FontSize="38"
                                      HorizontalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="PlaceholderText"
                                       Text="在左侧选择一个文件即可在此预览"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       MaxWidth="300"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="2" Spacing="6">
                        <TextBlock x:Name="InfoName"
                                   Text="未选择文件"
                                   Style="{ThemeResource BodyStrongTextBlockStyle}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="InfoMeta"
                                   Text="请从左侧列表选择文件"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="InfoPath"
                                   TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True"
                                   MaxHeight="60"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="OpenFileButton"
                                Content="打开文件"
                                IsEnabled="False"
                                Click="OpenFileButton_Click" />
                        <Button x:Name="OpenLocationButton"
                                Content="打开所在位置"
                                IsEnabled="False"
                                Click="OpenLocationButton_Click" />
                        <Button x:Name="CopyPathButton"
                                Content="复制路径"
                                IsEnabled="False"
                                Click="CopyPathButton_Click" />
                        <Button x:Name="RemoveSelectedButton"
                                Content="移除"
                                IsEnabled="False"
                                Click="RemoveSelectedButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>
            </Grid>
        </Grid>

        <!-- ============ 底部状态栏 ============ -->
        <Border Grid.Row="2"
                Padding="16,8"
                Margin="0,12,0,0"
                BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatsText"
                           Text="共 0 个文件"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="MessageText"
                           Grid.Column="1"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            </Grid>
        </Border>

        <!-- ============ 设置页面（覆盖侧边栏与主内容区，标题栏仍可用） ============ -->
        <Grid x:Name="SettingsPanel"
              Grid.Row="1"
              Grid.RowSpan="2"
              Visibility="Collapsed"
              Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="12,10"
                    BorderThickness="0"
                    Background="{ThemeResource LayerFillColorDefaultBrush}">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button x:Name="SettingsBackButton" Click="SettingsBackButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72B;" FontSize="14" />
                            <TextBlock Text="返回" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="设置" Style="{ThemeResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="1" Padding="24,18,24,24" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="14" MaxWidth="820" HorizontalAlignment="Left">

                    <!-- 关于 -->
                    <Border Padding="18"
                            CornerRadius="8"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="关于" Style="{ThemeResource SubtitleTextBlockStyle}" />

                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE786;"
                                          FontSize="30"
                                          VerticalAlignment="Center"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="LaterVideo" FontSize="16" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock x:Name="AboutVersionText"
                                               Text="版本 1.0.0"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="多媒体文件暂存与预览工具：拖拽导入图片 / 音乐音频 / 视频 / 文本 / 配置文件，集中管理、就地预览。" />

                            <TextBlock TextWrapping="Wrap" Text="创作者：LaterChip、Marvis、Visual Studio" />

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="GitHubLinkButton" Click="GitHubLinkButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE71B;" FontSize="14" />
                                        <TextBlock Text="github.com/LaterChip/LaterVideo" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="GitHubCopyButton" Content="复制链接" Click="GitHubCopyButton_Click" />
                            </StackPanel>

                            <TextBlock TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="点击仓库按钮会用系统默认浏览器打开 https://github.com/LaterChip/LaterVideo。" />
                        </StackPanel>
                    </Border>

                    <!-- 外观 -->
                    <Border Padding="18"
                            CornerRadius="8"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="外观" Style="{ThemeResource SubtitleTextBlockStyle}" />

                            <ComboBox x:Name="ThemeComboBox"
                                      Header="主题"
                                      MinWidth="220"
                                      SelectionChanged="ThemeComboBox_SelectionChanged">
                                <ComboBoxItem Content="跟随系统" />
                                <ComboBoxItem Content="浅色" />
                                <ComboBoxItem Content="深色" />
                            </ComboBox>

                            <ComboBox x:Name="ThumbnailSizeComboBox"
                                      Header="缩略图尺寸（网格视图）"
                                      MinWidth="220"
                                      SelectionChanged="ThumbnailSizeComboBox_SelectionChanged">
                                <ComboBoxItem Content="小（120 × 146）" />
                                <ComboBoxItem Content="中（152 × 180）" />
                                <ComboBoxItem Content="大（190 × 220）" />
                            </ComboBox>

                            <TextBlock TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="主题切换即时生效；缩略图尺寸改变后，已解码的缩略图会在下次启动应用时按新尺寸重新生成。" />
                        </StackPanel>
                    </Border>

                    <!-- 列表与视图 -->
                    <Border Padding="18"
                            CornerRadius="8"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="列表与视图" Style="{ThemeResource SubtitleTextBlockStyle}" />

                            <ComboBox x:Name="DefaultViewComboBox"
                                      Header="默认视图（未记住上次视图时使用）"
                                      MinWidth="220"
                                      SelectionChanged="DefaultViewComboBox_SelectionChanged">
                                <ComboBoxItem Content="列表视图" />
                                <ComboBoxItem Content="缩略图网格视图" />
                            </ComboBox>

                            <ToggleSwitch x:Name="RememberSessionToggle"
                                          Header="记住上次的文件清单"
                                          OnContent="开启"
                                          OffContent="关闭"
                                          Toggled="RememberSessionToggle_Toggled" />

                            <ToggleSwitch x:Name="RememberViewToggle"
                                          Header="记住上次的视图模式"
                                          OnContent="开启"
                                          OffContent="关闭"
                                          Toggled="RememberViewToggle_Toggled" />

                            <TextBlock TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="关闭「记住上次的文件清单」后，应用退出时不再保存当前列表，下次启动为空列表（磁盘上的文件不会被改动）。" />
                        </StackPanel>
                    </Border>

                    <!-- 数据 -->
                    <Border Padding="18"
                            CornerRadius="8"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="数据" Style="{ThemeResource SubtitleTextBlockStyle}" />

                            <TextBlock TextWrapping="Wrap"
                                       IsTextSelectionEnabled="True"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="配置目录：%LOCALAPPDATA%\LaterVideo" />

                            <TextBlock x:Name="SettingsPathText"
                                       TextWrapping="Wrap"
                                       IsTextSelectionEnabled="True"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="OpenDataFolderButton" Content="打开配置目录" Click="OpenDataFolderButton_Click" />
                                <Button x:Name="CopyDataPathButton" Content="复制目录路径" Click="CopyDataPathButton_Click" />
                                <Button x:Name="ClearSessionButton" Content="清除已保存的会话数据" Click="ClearSessionButton_Click" />
                            </StackPanel>

                            <TextBlock x:Name="SettingsStatusText"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />

                            <TextBlock TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="配置目录包含 session.json（列表清单与视图状态）与 settings.json（本页设置）。清除会话数据只删除列表清单文件，不影响磁盘上的任何用户文件。" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ============ 拖拽悬停遮罩 ============ -->
        <Border x:Name="DropOverlay"
                Grid.Row="0"
                Grid.RowSpan="3"
                Visibility="Collapsed"
                Background="#99000000"
                IsHitTestVisible="False">
            <Border Margin="48"
                    CornerRadius="12"
                    BorderThickness="2"
                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
                    <FontIcon Glyph="&#xE896;" FontSize="46" Foreground="White" HorizontalAlignment="Center" />
                    <TextBlock Text="松开鼠标，把文件导入 LaterVideo"
                               FontSize="20"
                               Foreground="White"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="支持图片 / 音乐音频 / 视频 / 文本 / 配置文件，以及整个文件夹"
                               Foreground="#CCFFFFFF"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
